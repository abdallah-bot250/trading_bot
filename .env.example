# Auto-trading execution exchange. Recommended when Binance is blocked: bybit
AUTO_TRADE_EXCHANGE=bybit
# Keep false unless debugging market scans
SIGNAL_DEBUG_LOGS=false
# Signal quality profile. conservative preserves current production behavior.
SIGNAL_QUALITY_PROFILE=conservative
# Safety guards against stale/chased entries
MAX_ENTRY_DEVIATION_PERCENT=0.35
ENTRY_CHASE_TOLERANCE_PERCENT=0.18
# Dynamic scanner size
MAX_DYNAMIC_SYMBOLS=120
MIN_DYNAMIC_SYMBOLS=20
SINGLE_SYMBOL_MODE=false
SYMBOL=
NO_SIGNAL_NOTIFY_COOLDOWN_HOURS=6

# Nexora launch defaults: safe large-cap volatility relaxation + AdsGram rewarded unlocks
STRICT_VOLATILITY_FILTER=false
MIN_DAILY_SIGNAL_TARGET=0
FREE_EARN_MODE=true
FREE_SIGNALS_LIFETIME=2
LOCKED_SIGNAL_TTL_MINUTES=10
REWARDED_AD_PROVIDER=adsgram
ADSGRAM_PLATFORM_ID=35044
ADSGRAM_BLOCK_ID=37291
ADSGRAM_REWARD_SECRET=
ADSGRAM_REQUIRE_SIGNATURE=false
FREE_UNLOCK_DEMO_MODE=false

# Sale readiness / verified proof tracking
NEXORA_PROOF_MODE=false
ENABLE_SIGNAL_TRACKING=true
SIGNAL_TRACKING_NOTIFY=false

# Forex market data and analysis. Forex signals are delivered only to vip_all_forex.
FOREX_SIGNAL_ENGINE_ENABLED=true
FOREX_DATA_PROVIDER=twelvedata
FOREX_DATA_API_KEY=your_forex_data_api_key
FOREX_REQUEST_TIMEOUT_SECONDS=8
FOREX_REQUEST_RETRIES=2
FOREX_CACHE_SECONDS=180
FOREX_MAX_CANDLE_STALE_SECONDS=1800
FOREX_MIN_RISK_REWARD=1.5
FOREX_MIN_CONFIDENCE=72
FOREX_MAX_SPREAD_PIPS=2.5
FOREX_MAX_SIGNALS_PER_CYCLE=2
FOREX_NEWS_BLACKOUT_ENABLED=true
FOREX_NEWS_BLACKOUT_ACTIVE=false
FOREX_AUTO_TRADE_ENABLED=false
